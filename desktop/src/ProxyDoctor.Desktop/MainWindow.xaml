<Window x:Class="ProxyDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网络代理医生"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="{DynamicResource App.Background}"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource App.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource App.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource App.Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Line}" BorderThickness="0,0,1,0" Padding="18,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="网络代理医生" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Windows Proxy Doctor" Foreground="{DynamicResource App.Muted}" Margin="0,2,0,18" />
          <TextBlock Text="{Binding ModeLabel}" TextWrapping="Wrap" Foreground="{DynamicResource App.Accent}" Margin="0,0,0,16" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <CheckBox Content="深色" IsChecked="{Binding Dark}" Foreground="{DynamicResource App.Ink}" Margin="0,0,0,8" />
          <CheckBox Content="演示数据" IsChecked="{Binding Demo}" Foreground="{DynamicResource App.Ink}" />
        </StackPanel>
        <StackPanel>
          <Button Content="概览" Command="{Binding ShowCommand}" CommandParameter="overview" Style="{StaticResource NavButton}" />
          <Button Content="隐私" Command="{Binding ShowCommand}" CommandParameter="privacy" Style="{StaticResource NavButton}" />
          <Button Content="恢复" Command="{Binding ShowCommand}" CommandParameter="recovery" Style="{StaticResource NavButton}" />
          <Button Content="事件" Command="{Binding ShowCommand}" CommandParameter="events" Style="{StaticResource NavButton}" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Padding="28,24" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <DockPanel Margin="0,0,0,16">
          <Button DockPanel.Dock="Right" Content="只读检查" Command="{Binding DiagnoseCommand}" MinWidth="120" />
          <StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource App.Muted}" TextWrapping="Wrap" Margin="0,6,80,0" />
          </StackPanel>
        </DockPanel>

        <StackPanel x:Name="OverviewPage">
          <UniformGrid Columns="2" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="系统代理" Foreground="{DynamicResource App.Muted}" />
                <TextBlock Text="{Binding Proxy}" FontSize="18" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,8">
              <StackPanel>
                <TextBlock Text="客户端进程" Foreground="{DynamicResource App.Muted}" />
                <TextBlock Text="{Binding Clients}" FontSize="18" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,8,8,0">
              <StackPanel>
                <TextBlock Text="回环监听" Foreground="{DynamicResource App.Muted}" />
                <TextBlock Text="{Binding Listeners}" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,8,0,0">
              <StackPanel>
                <TextBlock Text="默认代理路径的 HTTPS" Foreground="{DynamicResource App.Muted}" />
                <TextBlock Text="{Binding Probes}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="这次能说明什么" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="保护范围" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="未验证和未部署的项目不会显示成正常。" Foreground="{DynamicResource App.Muted}" Margin="0,6,0,12" />
              <TextBlock Text="{Binding Capabilities}" TextWrapping="Wrap" LineHeight="26" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="RecoveryPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="建议" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,8,0,12" />
              <TextBlock Text="这一版不会写入系统代理、防火墙或客户端。需要替换生产脚本时，使用已核对哈希的四个文件，并保留回滚副本。" TextWrapping="Wrap" Foreground="{DynamicResource App.Muted}" />
              <Button Content="保持当前选择" IsEnabled="False" Margin="0,16,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="EventsPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="本次会话" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Events}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="24" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
