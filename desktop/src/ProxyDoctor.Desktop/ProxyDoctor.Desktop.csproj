<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ProxyDoctor</AssemblyName>
    <Product>Windows Proxy Doctor Desktop</Product>
    <Version>1.3.0</Version>
    <Description>网络代理医生</Description>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProxyDoctor.Core\ProxyDoctor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      F69/F70: the complete portable engine whitelist. Three individual reviewed
      files, never a folder copy. Do not add settings.json, owner.json, backup\,
      logs\, evidence\ or any credential here.
    -->
    <Content Include="..\..\scripts\Invoke-IsolatedRecovery.ps1" Link="engine\scripts\Invoke-IsolatedRecovery.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\proxy_v4\rollback-v4.ps1" Link="engine\proxy_v4\rollback-v4.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\proxy_v4\lib\V4.ps1" Link="engine\proxy_v4\lib\V4.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\..\packaging\engine-manifest.targets" />
</Project>
