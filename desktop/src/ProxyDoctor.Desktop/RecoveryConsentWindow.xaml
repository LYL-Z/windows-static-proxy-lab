<Window x:Class="ProxyDoctor.Desktop.RecoveryConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权隔离演练"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Ink}"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="ConsentCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource App.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource App.Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
  </Window.Resources>
  <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="授权隔离演练" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="这不是真实生产写入。Executor 仍是 V4_TEST_MODE + stub，不会写真实系统代理。"
                 Foreground="{DynamicResource App.Warn}" TextWrapping="Wrap" Margin="0,6,0,0" />

      <Border Style="{StaticResource ConsentCard}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource FieldLabel}" Text="操作" />
          <TextBlock Style="{StaticResource FieldValue}" Text="RECOVER-ISOLATED（隔离演练）" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="目标（执行开始时重新读取，与这次绑定不符就拒绝）" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Target}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="操作范围" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Scope}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="受影响资源" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding AffectedResources}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="是否写系统代理" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SystemProxy}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="回滚方式" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Rollback}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="拒绝之后" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Refusal}" />
          <TextBlock Style="{StaticResource FieldLabel}" Text="同一段文字在 CLI 与 Skill 里也会展示" />
          <TextBlock Style="{StaticResource FieldValue}" Text="{Binding NotImplemented}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource ConsentCard}" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="点确认才算这次授权。授权只对这一次、这个目标有效。" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Phrase}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                     Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource App.Accent}" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="取消（只做只读诊断）" IsCancel="True" MinWidth="150" Margin="0,0,8,0" Padding="10,6" />
        <Button Content="我确认，执行隔离演练" IsDefault="True" MinWidth="180" Padding="10,6" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
